{
  "name": "@sustenaut/theme",
  "version": "0.1.0",
  "description": "Sustenaut's design tokens and fonts: a Tailwind 4 theme, the same tokens as plain CSS, and Nunito and Nunito Sans.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./theme.css": "./theme.css",
    "./tokens.css": "./tokens.css",
    "./fonts.css": "./fonts.css",
    "./base.css": "./base.css",
    "./tokens.json": "./tokens.json",
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "theme.css",
    "tokens.css",
    "fonts.css",
    "base.css",
    "tokens.json",
    "fonts"
  ],
  "scripts": {
    "build": "node tools/build.js",
    "test": "c8 --reporter=lcov --reporter=text-summary --reports-dir=coverage --include='tools/**' cucumber-js"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "c8": "12.0.0",
    "tailwindcss": "4.3.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sustenaut/theme.git"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.8"
  }
}
